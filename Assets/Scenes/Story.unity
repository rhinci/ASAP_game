    \u0435\u0433\u043E \u0438 \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C \u043B\u0435\u0441
    \u043E\u0442 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044C\u044F, \u0447\u0442\u043E
    \u0433\u0440\u043E\u0437\u0438\u0442 \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u0442\u044C
